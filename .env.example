# ============================================================
# 复制本文件为 .env 后填写，.env 不会提交到版本库
# 所有配置均通过环境变量注入，任意文件都不得写入真实密钥
# ============================================================

# ---------- DeepSeek（OpenAI 兼容接口） ----------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60

# ---------- Embedding（BGE 中文向量模型） ----------
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# auto / cpu / cuda / mps
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
# BGE 中文模型检索指令前缀，留空则不加前缀
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
# 可选：模型缓存目录
# MODEL_CACHE_DIR=./data/models
# 国内网络下载模型较慢时可使用 HuggingFace 镜像（也可直接设置系统环境变量 HF_ENDPOINT）
# HF_ENDPOINT=https://hf-mirror.com

# ---------- Chroma 向量库 ----------
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=knowledge_base

# ---------- 文档切分与检索 ----------
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=4
# 相似度阈值（余弦相似度，0~1），低于该值的片段会被丢弃；设为 0 表示不过滤
SCORE_THRESHOLD=0.2

# ---------- 上传 ----------
UPLOAD_DIR=./data/uploads
REGISTRY_PATH=./data/documents.json
MAX_UPLOAD_MB=20

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
